# Copy to .env and fill in. Every key is optional — the engine degrades
# gracefully when one is missing (skips that capability, never crashes).

# Anthropic API key — required for LLM scoring, resume tailoring, and cover
# letters. Without it, matching falls back to a heuristic scorer.
ANTHROPIC_API_KEY=

# Firecrawl API key — required to scrape job boards that have no public API
# (NeoGov/governmentjobs, iCIMS, PageUp, etc.) and to enrich detail pages.
FIRECRAWL_API_KEY=

# JSearch (RapidAPI) key — optional. Enables the Google-for-Jobs feed, which
# surfaces LinkedIn / Indeed / ZipRecruiter listings that can't be scraped
# directly. Get a free-tier key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Vercel Blob read/write token — only needed if you deploy "The Desk" review
# app and want the pipeline to publish live data, read the manual-link queue,
# or pull remote onboarding submissions (`apply onboard --fetch`).
BLOB_READ_WRITE_TOKEN=

# Optional overrides
# APPLY_DB=~/.apply-assistant/jobs.db     # SQLite location (default shown)
# APPLY_SCORE_MODEL=claude-haiku-4-5      # scoring model (cheap, high volume)
# APPLY_TAILOR_MODEL=claude-opus-5        # resume tailoring model
# APPLY_LETTER_MODEL=claude-opus-5        # cover-letter model
