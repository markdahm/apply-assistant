# Local data & state (never commit real candidate data or the job DB)
data/
*.db
*.db-wal
*.db-shm
.apply-assistant/

# The real candidate profile (keep only *.example.* templates in git)
config/profile.json
# Holds the candidate's target employers and search terms once
# onboarding has run — candidate data, not configuration.
config/sources.json
# The operator's own curated employers. Not written by onboarding, but it still
# describes who a specific person is being searched for.
config/sources.extra.json
profile/*.md
profile/raw/
profile/samples/
# Every backup the engine writes holds the same data as the file it replaced:
# onboarding's *.bak archives, and the normalizer's resume.md.raw.bak. The
# rules above are extension-anchored and miss all of them.
*.bak
!profile/README.md
!profile/*.example.md

# Generated artifacts
review-app/desk-data.js
site/desk-data.js
site/desk.html
site/onboard.html
# The guided tour embeds an annotated screenshot of the candidate's live queue
# as a data URI — real employers, real scores, their name on the resume pane.
# The template that builds it is tracked; the built page is not.
review-app/guide.html
site/guide.html
**/resume_*.pdf
**/resume.pdf
**/resume.html

# Secrets & env
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
.vscode/
.idea/
